rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(roomId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants; }
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow delete: if false;
    }
    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && roomId.matches('[A-Z0-9]{6}')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.videoId is string && request.resource.data.videoId.size() == 11
        && request.resource.data.currentTime == 0 && request.resource.data.isPlaying == false;
      allow update: if signedIn() && request.resource.data.createdBy == resource.data.createdBy
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
            && request.resource.data.participants is list && request.resource.data.participants.size() <= 50
            && request.resource.data.participants.toSet().difference(resource.data.participants.toSet()).hasOnly([request.auth.uid])
            && resource.data.participants.toSet().difference(request.resource.data.participants.toSet()).hasOnly([request.auth.uid]))
          ||
          (request.auth.uid in resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videoId', 'videoTitle', 'queue', 'currentTime', 'isPlaying', 'lastUpdatedAt', 'updatedBy', 'syncEventId'])
            && request.resource.data.videoId is string && request.resource.data.videoId.size() == 11
            && request.resource.data.currentTime is number && request.resource.data.currentTime >= 0 && request.resource.data.currentTime <= 864000
            && request.resource.data.isPlaying is bool
            && (!('queue' in request.resource.data) || (request.resource.data.queue is list && request.resource.data.queue.size() <= 30)))
        );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      match /messages/{messageId} {
        allow read: if member(roomId);
        allow create: if member(roomId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'audio']
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60
          && request.resource.data.reactions == {};
        allow update: if member(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions) || request.resource.data.reactions[request.auth.uid] in ['❤️', '😂', '🔥', '👏', '😮', '👍', '😍', '🥰', '😘', '🤣', '😅', '😭', '🥹', '😎', '🤔', '😱', '😢', '😡', '🤯', '🙌', '🙏', '💯', '🎉', '✨', '💔', '👀', '🤝', '😴', '🍿', '🎬', '🚀', '👎']);
        allow delete: if false;
      }
      match /presence/{userId} {
        allow read: if member(roomId);
        allow create, update: if member(roomId) && request.auth.uid == userId
          && request.resource.data.userId == userId && request.resource.data.name is string
          && request.resource.data.name.size() <= 60 && request.resource.data.active is bool;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
      match /readReceipts/{userId} {
        allow read: if member(roomId);
        allow create, update: if member(roomId) && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['messageId', 'readThrough', 'updatedAt'])
          && request.resource.data.messageId is string
          && request.resource.data.readThrough is timestamp
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(request.resource.data.messageId)).data.sentAt == request.resource.data.readThrough
          && get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(request.resource.data.messageId)).data.senderId != request.auth.uid
          && (resource == null || request.resource.data.readThrough >= resource.data.readThrough);
        allow delete: if false;
      }
      match /_translations/{id} { allow read, write: if false; }
    }
    match /_translationLimits/{id} { allow read, write: if false; }
  }
}
